# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres (pooled connection string from the Neon project "fashion-fiesta")
DATABASE_URL=

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob store "fashion-fiesta-photos" read write token
BLOB_READ_WRITE_TOKEN=

# Phase 3.5: Read their document. Anthropic API key, set in Vercel for all environments. Never commit it.
ANTHROPIC_API_KEY=
