# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres (pooled connection string from the Neon project "fashion-fiesta")
DATABASE_URL=

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob store "fashion-fiesta-photos" read write token
BLOB_READ_WRITE_TOKEN=

# Phase 3.5: Read their document. Anthropic API key, set in Vercel for all environments. Never commit it.
ANTHROPIC_API_KEY=

# Nightly backup: Vercel Cron sends this as a bearer token. Any long random string.
CRON_SECRET=

# Shop address for links sent to customers. Used once its DNS points at Vercel.
PUBLIC_APP_URL=

# Web push (idea 42). Public key is safe in the browser; the private key is a secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Email through Resend, from an address on the shop domain.
RESEND_API_KEY=
EMAIL_DOMAIN=fashionfiestauae.com
